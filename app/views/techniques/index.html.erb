<% content_for :title, "Techniques — nosh" %>

<div class="flex items-center justify-between mb-6">
  <h1 class="text-2xl font-bold">Techniques</h1>
  <div class="flex items-center gap-4">
    <%= link_to "Manage equipment", equipment_index_path, class: "text-sm text-stone-500 hover:text-amber-700" %>
    <%= link_to "+ New Technique", new_technique_path, class: "bg-amber-600 text-white px-4 py-2 rounded-md hover:bg-amber-700" %>
  </div>
</div>

<% if @techniques.empty? %>
  <p class="text-stone-500">No techniques yet.</p>
<% else %>
  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
    <% @techniques.each do |technique| %>
      <%= link_to technique, class: "block bg-white rounded-xl border border-black/10 shadow-xs hover:shadow-md transition-shadow px-4 py-3" do %>
        <h2 class="text-lg font-semibold text-stone-900"><%= technique.title %></h2>
        <% if technique.equipment.any? %>
          <p class="text-xs text-stone-500 mt-1"><%= technique.equipment.map(&:name).join(", ") %></p>
        <% end %>
        <p class="text-sm text-stone-600 mt-1 line-clamp-2"><%= technique.body %></p>
      <% end %>
    <% end %>
  </div>
<% end %>
