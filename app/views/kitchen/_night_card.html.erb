<%# Locals: entry, a night planned without a recipe ("Burrito night"). The
    same shape as kitchen/_recipe_card so the week's grid keeps its measured
    height, with nothing to open. %>
<div class="flex flex-col bg-white dark:bg-neutral-900 rounded-xl overflow-hidden border border-stone-200 dark:border-neutral-800 shadow-sm dark:shadow-none">
  <div class="aspect-video bg-amber-50 dark:bg-neutral-800 flex items-center justify-center px-4 text-center">
    <span class="text-2xl font-semibold text-amber-800 dark:text-amber-300 line-clamp-2"><%= entry.title %></span>
  </div>
  <div class="px-4 py-2.5 flex-1 flex flex-col gap-1">
    <p class="text-sm font-bold uppercase tracking-wide text-amber-700 dark:text-amber-400"><%= entry.date.strftime("%A") %></p>
    <h2 class="text-base font-semibold leading-tight line-clamp-2"><%= entry.title %></h2>
  </div>
</div>
