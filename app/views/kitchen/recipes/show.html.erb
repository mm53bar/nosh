<% content_for :title, "#{@recipe.title} — nosh" %>

<div class="h-full flex flex-col">
  <header class="shrink-0 flex items-center gap-5 px-6 py-4 border-b border-stone-200 bg-white"
          data-controller="made-it"
          data-made-it-url-value="<%= made_kitchen_recipe_path(@recipe) %>">
    <%# No browser chrome on the kiosk, so this is the only way back. %>
    <%= link_to kitchen_root_path,
          class: "shrink-0 flex items-center justify-center w-16 h-16 rounded-2xl bg-stone-100 text-3xl text-stone-600 active:bg-stone-200" do %>
      ←<span class="sr-only">Back to this week</span>
    <% end %>

    <div class="min-w-0 flex-1">
      <h1 class="text-3xl font-bold leading-tight truncate"><%= @recipe.title %></h1>
      <div class="flex items-center gap-4 text-lg text-stone-500 mt-0.5">
        <% if @recipe.total_time_minutes %>
          <span><%= format_minutes(@recipe.total_time_minutes) %></span>
        <% end %>
        <% if @recipe.servings %>
          <span><%= @recipe.servings %> servings</span>
        <% end %>
        <span data-made-it-target="label"><%= last_made_label(@recipe) %></span>
      </div>
    </div>

    <button type="button"
            data-action="made-it#mark"
            data-made-it-target="button"
            class="shrink-0 px-7 py-5 rounded-2xl bg-emerald-600 text-white text-xl font-semibold active:bg-emerald-700 disabled:bg-stone-300 disabled:text-stone-500">
      ✓ Made it
    </button>
  </header>

  <%# The whole reason this screen exists: ingredients and method on screen at
      the same time, so nobody scrolls back and forth with wet hands. Each pane
      scrolls on its own; the page itself never does. %>
  <main class="flex-1 grid grid-cols-[minmax(0,1fr)_minmax(0,2fr)] overflow-hidden">
    <aside class="overflow-y-auto px-7 py-6 border-r border-stone-200 bg-white">
      <h2 class="text-base font-bold uppercase tracking-wide text-stone-400 mb-4">Ingredients</h2>
      <% if @recipe.ingredients.any? %>
        <ul class="space-y-3">
          <% @recipe.ingredients.each do |ingredient| %>
            <li class="flex gap-3 leading-snug border-b border-stone-100 pb-3 last:border-0">
              <span class="font-semibold text-amber-700 whitespace-nowrap shrink-0">
                <%= [ ingredient.amount, ingredient.unit ].compact_blank.join(" ") %>
              </span>
              <span class="text-stone-800"><%= ingredient.name %></span>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="text-stone-400">No ingredients listed.</p>
      <% end %>
    </aside>

    <%# Same target/class names as the main app's show page, so the .step.active
        and .step.done rules in tailwind/application.css apply unchanged. The
        controller sits on the section rather than the <ol> so the progress
        readout is inside its scope. %>
    <section class="overflow-y-auto px-7 py-6" data-controller="step-checklist">
      <div class="flex items-baseline justify-between mb-4">
        <h2 class="text-base font-bold uppercase tracking-wide text-stone-400">Method</h2>
        <p class="text-base text-stone-400" data-step-checklist-target="progress"></p>
      </div>

      <% if @recipe.steps.any? %>
        <ol>
          <% @recipe.steps.each_with_index do |step, index| %>
            <li data-step-checklist-target="step"
                data-action="click->step-checklist#tap"
                class="step flex gap-5 py-5 border-b border-stone-100 last:border-0 cursor-pointer rounded-lg transition-colors">
              <span class="step-num text-amber-700 text-2xl font-bold opacity-40 shrink-0 w-8 transition-opacity"><%= index + 1 %></span>
              <span class="step-text text-[23px] text-stone-800 leading-relaxed"><%= step.instruction %></span>
            </li>
          <% end %>
        </ol>
      <% else %>
        <p class="text-stone-400">No steps listed.</p>
      <% end %>

      <% if @recipe.notes.present? %>
        <div class="bg-amber-50/60 border-l-4 border-amber-600 rounded-r-lg px-5 py-4 mt-6 text-stone-700 whitespace-pre-line">
          <%= @recipe.notes %>
        </div>
      <% end %>
    </section>
  </main>
</div>
