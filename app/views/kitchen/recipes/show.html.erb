<% content_for :title, "#{@recipe.title} — nosh" %>

<%# Two columns running top to bottom, no header band across them — the shape
    verso uses for its artwork screen, which is the household's other Echo Show
    page. The dish sits at the top of the left column, where Home Assistant
    floats its back button when this is embedded: a photo is a better thing to
    put under that button than blank space, and at this size the button is a
    corner overlay rather than half the picture. Each column scrolls on its own;
    the page itself never does. %>
<div class="h-full flex overflow-hidden">
  <aside class="w-[33%] shrink-0 flex flex-col border-r border-stone-200 dark:border-neutral-800 bg-white dark:bg-neutral-900">
    <%# The block is here for the button to land on as much as for the dish, so
        it renders either way: a photo at 16:9, or — for about one recipe in ten
        — a bare tinted band tall enough to hold the 74px square the button
        wants, and no taller. %>
    <figure class="shrink-0 <%= @recipe.image.attached? ? "aspect-video" : "h-[78px]" %> bg-stone-200 dark:bg-neutral-800 overflow-hidden">
      <%= kitchen_corner_image(@recipe, class: "w-full h-full object-cover") %>
    </figure>

    <div class="flex-1 overflow-y-auto px-7 py-5">
      <div class="flex items-baseline justify-between gap-3 mb-4">
        <h2 class="text-base font-bold uppercase tracking-wide text-stone-400 dark:text-neutral-500">Ingredients</h2>
        <% if @recipe.servings %>
          <p class="text-base text-stone-400 dark:text-neutral-500"><%= @recipe.servings %> servings</p>
        <% end %>
      </div>
      <% if @recipe.ingredients.any? %>
        <ul class="space-y-3">
          <% @recipe.ingredients.each do |ingredient| %>
            <li class="flex gap-3 leading-snug border-b border-stone-100 dark:border-neutral-800 pb-3 last:border-0">
              <span class="font-semibold text-amber-700 dark:text-amber-400 whitespace-nowrap shrink-0">
                <%= [ ingredient.amount, ingredient.unit ].compact_blank.join(" ") %>
              </span>
              <span class="text-stone-800 dark:text-neutral-200">
                <%= ingredient.name %><% if ingredient.note.present? %><span class="text-stone-400 dark:text-neutral-500">, <%= ingredient.note %></span><% end %>
              </span>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="text-stone-400 dark:text-neutral-500">No ingredients listed.</p>
      <% end %>
    </div>
  </aside>

  <section class="min-w-0 flex-1 flex flex-col">
    <%# Fixed while the method scrolls under it, so you always know what you're
        cooking. The way back sits above the title rather than beside it: it's
        the crumb this recipe hangs off, and stacked it can't be mistaken for a
        second copy of the host's button — theirs leaves nosh, this goes up to
        the week. With the row to itself the title wraps instead of truncating. %>
    <header class="shrink-0 px-7 pt-2 pb-3 border-b border-stone-200 dark:border-neutral-800">
      <%# py-2.5 rather than the smallest padding that fits the text: this is the
          only way back inside nosh and it gets hit with a knuckle. %>
      <%= link_to kitchen_root_path,
            class: "inline-flex items-center gap-1.5 py-2.5 pe-4 text-base font-semibold text-amber-700 dark:text-amber-400 active:text-amber-900 dark:active:text-amber-200" do %>
        <span aria-hidden="true">‹</span> This week
      <% end %>

      <%# Times and servings live in the pane headings that describe them, and
          "made it" at the end of the method — so this is the title alone. %>
      <h1 class="text-2xl font-bold leading-tight line-clamp-2"><%= @recipe.title %></h1>
    </header>

    <%# Same target/class names as the main app's show page, so the .step.active
        and .step.done rules in tailwind/application.css apply unchanged. The
        controller sits on the scrolling pane rather than the <ol> so the
        progress readout is inside its scope. %>
    <div class="flex-1 overflow-y-auto px-7 py-5" data-controller="step-checklist">
      <div class="flex items-baseline justify-between mb-4">
        <h2 class="text-base font-bold uppercase tracking-wide text-stone-400 dark:text-neutral-500">Method</h2>
        <div class="flex items-baseline gap-4 text-base text-stone-400 dark:text-neutral-500">
          <% if @recipe.total_time_minutes %>
            <p><%= format_minutes(@recipe.total_time_minutes) %></p>
          <% end %>
          <p data-step-checklist-target="progress"></p>
        </div>
      </div>

      <% if @recipe.steps.any? %>
        <ol>
          <% @recipe.steps.each_with_index do |step, index| %>
            <li data-step-checklist-target="step"
                data-action="click->step-checklist#tap"
                class="step flex gap-5 py-5 border-b border-stone-100 dark:border-neutral-800 last:border-0 cursor-pointer rounded-lg transition-colors">
              <span class="step-num text-amber-700 dark:text-amber-400 text-2xl font-bold opacity-40 shrink-0 w-8 transition-opacity"><%= index + 1 %></span>
              <span class="step-text text-[23px] text-stone-800 dark:text-neutral-200 leading-relaxed"><%= step.instruction %></span>
            </li>
          <% end %>
        </ol>
      <% else %>
        <p class="text-stone-400 dark:text-neutral-500">No steps listed.</p>
      <% end %>

      <% if @recipe.notes.present? %>
        <div class="bg-amber-50/60 dark:bg-amber-950/40 border-l-4 border-amber-600 dark:border-amber-500 rounded-r-lg px-5 py-4 mt-6 text-stone-700 dark:text-neutral-200 whitespace-pre-line">
          <%= @recipe.notes %>
        </div>
      <% end %>

      <%# At the bottom of the method, because that's where the cook is when it
          becomes true. Nothing reports how long ago this was last made: on the
          screen you're cooking from, that's a fact about some other day. %>
      <div class="mt-8" data-controller="made-it" data-made-it-url-value="<%= made_kitchen_recipe_path(@recipe) %>">
        <button type="button"
                data-action="made-it#mark"
                data-made-it-target="button"
                class="w-full px-6 py-4 rounded-2xl bg-emerald-600 dark:bg-emerald-500 text-white dark:text-neutral-950 text-xl font-semibold active:bg-emerald-700 dark:active:bg-emerald-400 disabled:bg-stone-300 disabled:text-stone-500 dark:disabled:bg-neutral-800 dark:disabled:text-neutral-500">
          ✓ Made it
        </button>
      </div>
    </div>
  </section>
</div>
