<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Nosh" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Nosh">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-stone-50 text-stone-900 min-h-screen">
    <header class="border-b border-stone-200 bg-white">
      <div class="container mx-auto px-5 py-4 flex items-center gap-6">
        <%= link_to root_path, class: "text-lg font-semibold" do %>
          🍲 nosh
        <% end %>
        <%= render "shared/components/navbar/navbar",
              variant: "transparent",
              items: [
                { label: "Recipes", href: recipes_path, active: controller_name == "recipes" },
                { label: "Meal Plan", href: meal_plan_entries_path, active: controller_name == "meal_plan_entries" },
                { label: "Shopping List", href: shopping_list_path, active: controller_name == "shopping_lists" }
              ] %>
      </div>
    </header>

    <main class="container mx-auto px-5 py-8">
      <% flash.each do |type, message| %>
        <div class="mb-4 rounded-md px-4 py-3 <%= type == "alert" ? "bg-red-100 text-red-800" : "bg-emerald-100 text-emerald-800" %>">
          <%= message %>
        </div>
      <% end %>

      <%= yield %>
    </main>

    <footer class="container mx-auto px-5 py-6 text-xs text-stone-400 text-center">
      <% sha = Rails.configuration.x.git_sha %>
      <% short = Rails.configuration.x.git_sha_short %>
      <% if sha.present? && !%w[dev unknown].include?(sha) %>
        <%= link_to short, "https://github.com/mm53bar/nosh/commit/#{sha}",
              target: "_blank", rel: "noopener", class: "font-mono hover:text-stone-600" %>
      <% else %>
        <span class="font-mono"><%= short %></span>
      <% end %>
    </footer>
  </body>
</html>
