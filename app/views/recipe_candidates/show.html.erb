<% content_for :title, "Review #{@candidate.title} — nosh" %>

<div class="max-w-3xl">
  <%= link_to "‹ To review", recipe_candidates_path, class: "text-sm text-stone-500 hover:text-stone-800" %>
  <h1 class="text-2xl font-bold mt-2 mb-1">Review: <%= @candidate.title %></h1>
  <p class="text-sm text-stone-500 mb-4">
    From <%= link_to "the video", @candidate.source_url, target: "_blank", rel: "noopener", class: "text-amber-700 hover:underline" %>.
    Check it against the video, fix anything that's off, then add it. Nothing is in the collection until you do.
  </p>

  <% if @candidate.failed? %>
    <div class="mb-4 rounded-md bg-red-50 border border-red-200 px-4 py-3 text-sm text-red-800">
      The model couldn't read a recipe from this video (<%= @candidate.error %>). Fill the form in by hand from the transcript below, or discard it.
    </div>
  <% elsif !@candidate.recipe? %>
    <div class="mb-4 rounded-md bg-stone-100 px-4 py-3 text-sm text-stone-700">
      The model says this isn't a recipe<%= ": #{@candidate.skip_reason}" if @candidate.skip_reason %>.
    </div>
  <% end %>

  <% if @candidate.meat_warnings.any? %>
    <div class="mb-4 rounded-md bg-red-50 border border-red-200 px-4 py-3 text-sm text-red-800">
      <p class="font-medium">This may not be vegetarian. Check these lines:</p>
      <ul class="list-disc list-inside mt-1">
        <% @candidate.meat_warnings.each do |line| %><li><%= line %></li><% end %>
      </ul>
    </div>
  <% end %>

  <div class="flex items-start gap-4 mb-6">
    <% if @candidate.image_url.present? %>
      <%= image_tag @candidate.image_url, alt: "", class: "w-40 rounded-md shrink-0" %>
    <% end %>
    <div class="text-sm text-stone-600">
      <p>The video's thumbnail becomes the photo unless you upload one.</p>
      <%= button_to "Discard", discard_recipe_candidate_path(@candidate),
            class: "mt-2 text-red-700 hover:underline",
            form: { data: { turbo_confirm: "Discard \"#{@candidate.title}\"? It won't be suggested again." } } %>
    </div>
  </div>

  <%= render "recipes/form", url: accept_recipe_candidate_path(@candidate), submit: "Add to recipes" %>

  <details class="mt-10 text-sm">
    <summary class="cursor-pointer text-stone-600">Transcript</summary>
    <div class="mt-2 whitespace-pre-wrap text-stone-700"><%= @candidate.source_text %></div>
  </details>
</div>
