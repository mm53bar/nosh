<div class="flex gap-2 items-start" data-nested-fields-target="row">
  <%= form.hidden_field :id %>
  <%= form.text_area :instruction, rows: 2, placeholder: "Step instruction", class: "border rounded-md px-2 py-1 flex-1" %>
  <%= form.hidden_field :_destroy %>
  <button type="button" data-action="nested-fields#remove" class="text-red-600 px-2" aria-label="Remove step">✕</button>
</div>
