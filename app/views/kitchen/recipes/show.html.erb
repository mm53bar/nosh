<% content_for :title, "#{@recipe.title} — nosh" %>

<div class="h-full flex flex-col">
  <header class="shrink-0 flex items-center gap-5 <%= kitchen_corner_reserve("ps-6") %> pe-6 py-4 border-b border-stone-200 dark:border-neutral-800 bg-white dark:bg-neutral-900"
          data-controller="made-it"
          data-made-it-url-value="<%= made_kitchen_recipe_path(@recipe) %>">
    <div class="min-w-0 flex-1">
      <%# No browser chrome on the kiosk, so this is the only way back within
          nosh — but a labelled link above the title rather than a glyph in a
          box. Embedded, Home Assistant draws its own round back button in the
          corner, and two bare arrows side by side read as one control repeated.
          They're two levels rather than two spellings of the same thing: theirs
          leaves nosh, this one goes up to the week. So this one dresses as part
          of the recipe's own heading instead of competing with the host's
          chrome. Trailing padding only — the leading edge is pinned to the
          reserved corner and mustn't creep back into it. %>
      <%= link_to kitchen_root_path,
            class: "inline-flex items-center gap-1.5 py-1.5 pe-3 text-lg font-semibold text-amber-700 dark:text-amber-400 active:text-amber-900 dark:active:text-amber-200" do %>
        <span aria-hidden="true">‹</span> This week
      <% end %>

      <h1 class="text-3xl font-bold leading-tight truncate"><%= @recipe.title %></h1>
      <div class="flex items-center gap-4 text-lg text-stone-500 dark:text-neutral-400 mt-0.5">
        <% if @recipe.total_time_minutes %>
          <span><%= format_minutes(@recipe.total_time_minutes) %></span>
        <% end %>
        <% if @recipe.servings %>
          <span><%= @recipe.servings %> servings</span>
        <% end %>
        <span data-made-it-target="label"><%= last_made_label(@recipe) %></span>
      </div>
    </div>

    <button type="button"
            data-action="made-it#mark"
            data-made-it-target="button"
            class="shrink-0 px-7 py-5 rounded-2xl bg-emerald-600 dark:bg-emerald-500 text-white dark:text-neutral-950 text-xl font-semibold active:bg-emerald-700 dark:active:bg-emerald-400 disabled:bg-stone-300 disabled:text-stone-500 dark:disabled:bg-neutral-800 dark:disabled:text-neutral-500">
      ✓ Made it
    </button>
  </header>

  <%# The whole reason this screen exists: ingredients and method on screen at
      the same time, so nobody scrolls back and forth with wet hands. Each pane
      scrolls on its own; the page itself never does. %>
  <main class="flex-1 grid grid-cols-[minmax(0,1fr)_minmax(0,2fr)] overflow-hidden">
    <aside class="overflow-y-auto px-7 py-6 border-r border-stone-200 dark:border-neutral-800 bg-white dark:bg-neutral-900">
      <h2 class="text-base font-bold uppercase tracking-wide text-stone-400 dark:text-neutral-500 mb-4">Ingredients</h2>
      <% if @recipe.ingredients.any? %>
        <ul class="space-y-3">
          <% @recipe.ingredients.each do |ingredient| %>
            <li class="flex gap-3 leading-snug border-b border-stone-100 dark:border-neutral-800 pb-3 last:border-0">
              <span class="font-semibold text-amber-700 dark:text-amber-400 whitespace-nowrap shrink-0">
                <%= [ ingredient.amount, ingredient.unit ].compact_blank.join(" ") %>
              </span>
              <span class="text-stone-800 dark:text-neutral-200">
                <%= ingredient.name %><% if ingredient.note.present? %><span class="text-stone-400 dark:text-neutral-500">, <%= ingredient.note %></span><% end %>
              </span>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="text-stone-400 dark:text-neutral-500">No ingredients listed.</p>
      <% end %>
    </aside>

    <%# Same target/class names as the main app's show page, so the .step.active
        and .step.done rules in tailwind/application.css apply unchanged. The
        controller sits on the section rather than the <ol> so the progress
        readout is inside its scope. %>
    <section class="overflow-y-auto px-7 py-6" data-controller="step-checklist">
      <div class="flex items-baseline justify-between mb-4">
        <h2 class="text-base font-bold uppercase tracking-wide text-stone-400 dark:text-neutral-500">Method</h2>
        <p class="text-base text-stone-400 dark:text-neutral-500" data-step-checklist-target="progress"></p>
      </div>

      <% if @recipe.steps.any? %>
        <ol>
          <% @recipe.steps.each_with_index do |step, index| %>
            <li data-step-checklist-target="step"
                data-action="click->step-checklist#tap"
                class="step flex gap-5 py-5 border-b border-stone-100 dark:border-neutral-800 last:border-0 cursor-pointer rounded-lg transition-colors">
              <span class="step-num text-amber-700 dark:text-amber-400 text-2xl font-bold opacity-40 shrink-0 w-8 transition-opacity"><%= index + 1 %></span>
              <span class="step-text text-[23px] text-stone-800 dark:text-neutral-200 leading-relaxed"><%= step.instruction %></span>
            </li>
          <% end %>
        </ol>
      <% else %>
        <p class="text-stone-400 dark:text-neutral-500">No steps listed.</p>
      <% end %>

      <% if @recipe.notes.present? %>
        <div class="bg-amber-50/60 dark:bg-amber-950/40 border-l-4 border-amber-600 dark:border-amber-500 rounded-r-lg px-5 py-4 mt-6 text-stone-700 dark:text-neutral-200 whitespace-pre-line">
          <%= @recipe.notes %>
        </div>
      <% end %>
    </section>
  </main>
</div>
