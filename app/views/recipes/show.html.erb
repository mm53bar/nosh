<% content_for :title, "#{@recipe.title} — nosh" %>

<% content_for :head do %>
  <script type="application/ld+json"><%= json_escape(recipe_structured_data(@recipe).to_json).html_safe %></script>
<% end %>

<div class="max-w-4xl">
  <div class="flex items-center justify-between text-sm">
    <%= link_to "← All recipes", recipes_path, class: "text-stone-400 hover:text-amber-700" %>
    <div class="flex gap-3 text-xs text-stone-400">
      <%= link_to "Edit", edit_recipe_path(@recipe), class: "hover:text-stone-600" %>
      <%= button_to "Delete", recipe_path(@recipe), method: :delete, data: { turbo_confirm: "Delete this recipe?" }, class: "hover:text-red-600 bg-transparent border-0 p-0 cursor-pointer" %>
    </div>
  </div>

  <% if @recipe.image.attached? %>
    <%= image_tag @recipe.image, class: "w-full max-h-96 object-cover rounded-lg mt-3" %>
  <% end %>

  <h1 class="text-3xl font-bold text-stone-900 mt-4"><%= @recipe.title %></h1>

  <div class="flex items-center gap-3 flex-wrap mt-2 text-sm">
    <% if @recipe.cuisine.present? %>
      <span class="inline-flex items-center rounded-md bg-amber-50 px-1.5 py-0.5 text-[11px] font-medium text-amber-700 outline outline-amber-600/20">
        <%= @recipe.cuisine %>
      </span>
    <% end %>
    <%= recipe_stars(@recipe.rating) %>
    <% if @recipe.servings %>
      <span class="text-stone-500"><%= @recipe.servings %> servings</span>
    <% end %>
    <% if recipe_effort(@recipe) %>
      <span class="inline-flex items-center gap-1.5 text-stone-600">
        <%= effort_dot(recipe_effort(@recipe)) %>
        <%= recipe_effort(@recipe) %> · <%= format_minutes(@recipe.total_time_minutes) %>
      </span>
    <% end %>
    <% if @recipe.prep_time_minutes %>
      <span class="text-stone-400 text-xs">prep <%= format_minutes(@recipe.prep_time_minutes) %></span>
    <% end %>
  </div>

  <% if @recipe.tags.any? || @recipe.equipment.any? || @recipe.techniques.any? %>
    <div class="flex gap-2 flex-wrap mt-3">
      <% @recipe.tags.each do |tag| %>
        <span class="bg-stone-100 text-stone-600 text-xs px-2 py-1 rounded-full"><%= tag.name %></span>
      <% end %>
      <% @recipe.equipment.each do |equipment| %>
        <span class="bg-stone-100 text-stone-600 text-xs px-2 py-1 rounded-full"><%= equipment.name %></span>
      <% end %>
      <% @recipe.techniques.each do |technique| %>
        <%= link_to technique.title, technique, class: "bg-stone-100 text-amber-700 text-xs px-2 py-1 rounded-full hover:bg-stone-200" %>
      <% end %>
    </div>
  <% end %>

  <% if @recipe.description.present? %>
    <p class="text-stone-600 leading-relaxed mt-4"><%= @recipe.description %></p>
  <% end %>

  <% if @recipe.source_url.present? %>
    <p class="text-xs text-stone-400 mt-2">
      Source:
      <%= link_to @recipe.source_url, @recipe.source_url, class: "text-amber-700 hover:underline", target: "_blank", rel: "noopener" %>
    </p>
  <% end %>

  <div class="grid grid-cols-1 md:grid-cols-[1fr_2fr] gap-10 mt-8">
    <div>
      <p class="text-xs font-bold uppercase tracking-wide text-stone-400 mb-3">Ingredients</p>
      <% if @recipe.ingredients.any? %>
        <ul class="space-y-2.5">
          <% @recipe.ingredients.each do |ingredient| %>
            <li class="flex gap-3 text-[15px] border-b border-stone-100 pb-2 last:border-0 last:pb-0">
              <span class="font-semibold text-amber-700 whitespace-nowrap shrink-0">
                <%= [ ingredient.amount, ingredient.unit ].compact_blank.join(" ") %>
              </span>
              <span class="text-stone-800"><%= ingredient.name %></span>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="text-stone-400 text-sm">No ingredients listed.</p>
      <% end %>
    </div>

    <div>
      <div class="flex items-center justify-between flex-wrap gap-2">
        <p class="text-xs font-bold uppercase tracking-wide text-stone-400">Method</p>
        <% if @recipe.steps.any? %>
          <label class="inline-flex items-center gap-2 text-sm text-stone-500 cursor-pointer select-none" data-controller="wake-lock">
            <span class="relative inline-block w-9 h-5 shrink-0">
              <input type="checkbox" class="peer sr-only" data-wake-lock-target="toggle" data-action="change->wake-lock#toggle">
              <span class="absolute inset-0 rounded-full bg-stone-300 peer-checked:bg-[#27ae60] transition-colors pointer-events-none"></span>
              <span class="absolute left-0.5 top-0.5 w-4 h-4 bg-white rounded-full shadow transition-transform peer-checked:translate-x-4 pointer-events-none"></span>
            </span>
            Keep awake
          </label>
        <% end %>
      </div>

      <% if @recipe.steps.any? %>
        <p class="text-xs text-stone-400 mt-1">Tap a step to track your progress</p>
        <ol class="mt-3 space-y-0" data-controller="step-checklist">
          <% @recipe.steps.each_with_index do |step, index| %>
            <li data-step-checklist-target="step"
                data-action="click->step-checklist#tap"
                class="step flex gap-4 py-3 border-b border-stone-100 last:border-0 cursor-pointer rounded-md transition-colors">
              <span class="step-num text-amber-700 font-bold opacity-40 shrink-0 transition-opacity"><%= index + 1 %></span>
              <span class="step-text text-stone-800 leading-relaxed"><%= step.instruction %></span>
            </li>
          <% end %>
        </ol>
        <p class="text-xs text-stone-400 mt-2" data-step-checklist-target="progress"></p>
      <% else %>
        <p class="text-stone-400 text-sm mt-3">No steps listed.</p>
      <% end %>
    </div>
  </div>

  <% if @recipe.notes.present? %>
    <div class="bg-amber-50/60 border-l-4 border-amber-600 rounded-r-md px-4 py-3 mt-8 text-stone-700 whitespace-pre-line">
      <%= @recipe.notes %>
    </div>
  <% end %>

  <div class="flex items-center gap-4 mt-6 bg-stone-100 rounded-lg px-4 py-3">
    <span class="text-sm text-stone-500 flex-1">
      <% if @recipe.last_made_on %>
        Last made: <strong class="text-stone-800"><%= @recipe.last_made_on.to_fs(:long) %></strong>
      <% else %>
        <span class="text-stone-400">Never logged</span>
      <% end %>
    </span>
    <%= button_to "✓ Made it", made_recipe_path(@recipe), method: :post, class: "bg-emerald-600 text-white px-4 py-2 rounded-md hover:bg-emerald-700 text-sm font-semibold" %>
  </div>
</div>
