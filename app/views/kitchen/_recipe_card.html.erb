<%# Locals: recipe (required), label (optional overline, e.g. the planned day)
    A whole-card tap target — this gets hit with a knuckle. %>
<%= link_to kitchen_recipe_path(recipe),
      class: "group flex flex-col bg-white dark:bg-neutral-900 rounded-2xl overflow-hidden border border-stone-200 dark:border-neutral-800 shadow-sm dark:shadow-none active:border-amber-600 dark:active:border-amber-400 active:shadow-none transition" do %>
  <div class="aspect-video bg-stone-200 dark:bg-neutral-800 overflow-hidden">
    <% if (image = kitchen_card_image(recipe, class: "w-full h-full object-cover")) %>
      <%= image %>
    <% else %>
      <div class="w-full h-full flex items-center justify-center text-stone-400 dark:text-neutral-500">No photo</div>
    <% end %>
  </div>

  <div class="px-5 py-4 flex-1 flex flex-col gap-1.5">
    <% if local_assigns[:label].present? %>
      <p class="text-base font-bold uppercase tracking-wide text-amber-700 dark:text-amber-400"><%= label %></p>
    <% end %>

    <h2 class="text-2xl font-semibold leading-tight line-clamp-2"><%= recipe.title %></h2>

    <div class="mt-auto pt-2 flex items-center gap-3 text-lg text-stone-500 dark:text-neutral-400">
      <% if recipe.total_time_minutes %>
        <span><%= format_minutes(recipe.total_time_minutes) %></span>
      <% end %>
      <% if recipe.servings %>
        <span><%= recipe.servings %> servings</span>
      <% end %>
    </div>
  </div>
<% end %>
